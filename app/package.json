{
  "name": "al-zij-app",
  "version": "1.0.0",
  "private": true,
  "description": "Al-Zij (الزيج) — iPhone app shell around the offline web app, with adhan alerts as iOS local notifications",
  "license": "UNLICENSED",
  "scripts": {
    "sounds": "python3 scripts/make-sounds.py www-src/sounds",
    "bundle": "node scripts/bundle-web.mjs",
    "test": "node --test test/schedule.test.mjs test/inject.test.mjs",
    "test:e2e": "node test/bridge.e2e.mjs",
    "sync": "npm run bundle && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
