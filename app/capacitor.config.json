{
  "appId": "com.alzijapp.app",
  "appName": "الزيج",
  "webDir": "www",
  "backgroundColor": "#0a0c12",
  "loggingBehavior": "debug",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0a0c12",
    "limitsNavigationsToAppBoundDomains": false,
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "LocalNotifications": {
      "presentationOptions": ["banner", "list", "sound"]
    },
    "CapacitorHttp": {
      "enabled": false
    }
  }
}
