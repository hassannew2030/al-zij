{
  "appId": "com.alzijapp.app",
  "appName": "الزيج",
  "webDir": "www",
  "backgroundColor": "#0a0c12",
  "loggingBehavior": "debug",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0a0c12",
    "limitsNavigationsToAppBoundDomains": false,
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "LocalNotifications": {
      "presentationOptions": [
        "banner",
        "list",
        "sound"
      ],
      "smallIcon": "ic_stat_zij",
      "iconColor": "#C9A35D"
    },
    "CapacitorHttp": {
      "enabled": false
    }
  },
  "android": {
    "backgroundColor": "#0a0c12",
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  }
}
